"""Executable wrapper so the tool runs from anywhere without installation."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

# No `# noqa: E402` here, unlike the scripts/ ones. Ruff lets a run of sys.path
# calls precede an import; what it objects to there is the assignments those
# scripts make in between.
from clocwork.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
