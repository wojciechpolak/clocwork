#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Wojciech Polak
# SPDX-License-Identifier: GPL-3.0-or-later

"""Write Formula/clocwork.rb for the wojciechpolak/homebrew-clocwork tap.

The tap formula is derived. A release supplies the version and the checksum of
the wheel it published, and this script writes the whole file from those two
numbers, so an edit made in the tap cannot survive a release unnoticed. Two
runs over one release produce the same bytes.

It reads its inputs from the command line and writes one file. It resolves no
tags, downloads nothing and hashes nothing: the caller hands it the checksum,
so it behaves the same in CI and offline.

    scripts/render-homebrew-formula <version> <sha256>
    scripts/render-homebrew-formula <version> <sha256> --out FILE
    scripts/render-homebrew-formula <version> <sha256> --check FILE

With neither option the formula goes to stdout. --check exits 1 when the file
on disk differs from what would be written, which is how the release job knows
to skip an empty commit.
"""

import argparse
import re
import sys
from pathlib import Path

REPOSITORY = "https://github.com/wojciechpolak/clocwork"

# The formula installs the release wheel rather than the sdist. A wheel needs
# no build backend, so `brew install` reaches PyPI for nothing and the formula
# carries no `resource` blocks. Building the sdist would pull hatchling and
# five of its dependencies into a project whose rule is that it has none.
WHEEL = "clocwork-{version}-py3-none-any.whl"

# `python3` in Homebrew points here today. Bumping it is a one-line edit.
# The tap's own CI installs on macOS and Linux, so a python clocwork cannot
# run on fails there rather than in someone's terminal.
PYTHON = "python@3.14"

# `brew search` and `brew info` show this line alone, so it has to say what the
# program does without the README. Homebrew audits it: leading capital, not the
# formula name, no trailing full stop, under 80 characters.
DESCRIPTION = "Aggregate cloc line counts across several projects into one report"

# Only full releases reach the tap. `brew install` resolves to whatever the tap
# holds, and 0.9.0-rc.1 is a candidate for 0.9.0 rather than 0.9.0. A leading
# `v` is accepted because callers pass a git tag.
STABLE_VERSION = re.compile(r"^v?(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$")

# Lowercase hex, as both `sha256sum` and `shasum -a 256` print it.
SHA256 = re.compile(r"^[a-f0-9]{64}$")

HEADER = """\
# SPDX-FileCopyrightText: 2026 Wojciech Polak
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Generated by scripts/render-homebrew-formula in wojciechpolak/clocwork and
# rewritten in full by that repository's release workflow. Edit the renderer,
# not this file.
"""


def release_version(value: str) -> str:
    """The bare MAJOR.MINOR.PATCH. Raises ValueError on anything else."""
    match = STABLE_VERSION.match(value or "")
    if not match:
        raise ValueError(
            f"{value!r} is not a stable release version (MAJOR.MINOR.PATCH)"
        )
    return ".".join(match.groups())


def release_checksum(value: str) -> str:
    """The same digest, once it is known to be one."""
    if not SHA256.match(value or ""):
        raise ValueError(f"{value!r} is not a 64-character lowercase hex SHA-256")
    return value


def render_formula(version: str, sha256: str) -> str:
    """The complete contents of Formula/clocwork.rb.

    `using: :nounzip` is what keeps the wheel a file rather than an unpacked
    directory, so pip is handed something it can install.

    cloc is a hard runtime dependency: collect.ensure_cloc exits 2 without it,
    and its message already says `brew install cloc`. git clones and fetches a
    remote `repo`, and it is what --vcs=git has cloc ask for the file list.

    The test block runs a real count rather than only asking for a version.
    A virtualenv that installed cleanly but cannot import prints a version
    perfectly well.
    """
    release = release_version(version)
    checksum = release_checksum(sha256)
    wheel = WHEEL.format(version=release)
    # Homebrew parses `version` out of the url, so the install line names the
    # file through that rather than repeating the number. The two cannot
    # disagree about which wheel was downloaded.
    wheel_ruby = WHEEL.format(version="#{version}")
    venv_python = PYTHON.replace("@", "")

    return f"""{HEADER}
class Clocwork < Formula
  include Language::Python::Virtualenv

  desc "{DESCRIPTION}"
  homepage "{REPOSITORY}"
  url "{REPOSITORY}/releases/download/v{release}/{wheel}", using: :nounzip
  sha256 "{checksum}"
  license "GPL-3.0-or-later"

  depends_on "cloc"
  depends_on "git"
  depends_on "{PYTHON}"

  def install
    venv = virtualenv_create(libexec, "{venv_python}")
    venv.pip_install_and_link buildpath/"{wheel_ruby}"
  end

  test do
    reported = shell_output("#{{bin}}/clocwork --version").strip
    assert_equal "clocwork #{{version}}", reported

    (testpath/"src").mkpath
    (testpath/"src/hello.py").write "print('hi')\\n"
    config = testpath/"projects.toml"
    config.write <<~TOML
      [defaults]
      root = "."
      vcs = "none"

      [[project]]
      repo = "src"
      name = "Sample"
    TOML

    output = shell_output("#{{bin}}/clocwork --quiet --config #{{config}} --stdout txt")
    assert_match "Python", output
    assert_match "Sample", output
  end
end
"""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="render-homebrew-formula",
        description="Write the Homebrew formula for a stable clocwork release.",
    )
    parser.add_argument("version", help="release version or git tag, e.g. v0.9.0")
    parser.add_argument("sha256", help="SHA-256 of that release's wheel")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--out", metavar="FILE", help="write the formula here")
    group.add_argument(
        "--check",
        metavar="FILE",
        help="exit 1 unless FILE already holds this formula",
    )
    args = parser.parse_args(argv)

    try:
        formula = render_formula(args.version, args.sha256)
    except ValueError as exc:
        print(f"render-homebrew-formula: {exc}", file=sys.stderr)
        return 2

    if args.check:
        target = Path(args.check)
        current = target.read_text() if target.is_file() else ""
        if current != formula:
            print(
                f"{target} does not match the formula for {args.version}",
                file=sys.stderr,
            )
            return 1
        return 0

    if args.out:
        target = Path(args.out)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(formula)
        print(f"wrote {target}", file=sys.stderr)
        return 0

    sys.stdout.write(formula)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
